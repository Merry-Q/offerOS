DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_GENERATION_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/text-generation/generation
# 新版工作空间请按百炼控制台配置对应的 cn-beijing 工作空间端点
QWEN_MODEL=qwen-plus
QWEN_FAST_MODEL=qwen-flash
QWEN_ACTION_MODEL=qwen-plus
QWEN_SEARCH_MODEL=qwen-plus
DISCOVERY_LIMIT=24
# 不足目标数量时继续补搜；搜索最多6路，同时2路
DISCOVERY_SEARCH_ROUNDS=6
# 搜索引用和一跳详情共用核验预算，不会无限抓取
DISCOVERY_CANDIDATE_LIMIT=96
DISCOVERY_VERIFY_WORKERS=4
LLM_MODE=auto
LLM_TIMEOUT_FAST=12
LLM_TIMEOUT_ACTION=45
LLM_TIMEOUT_DEFAULT=60
# 反向代理子路径，例如 /offeros；根路径部署保持为空
OFFEROS_BASE_PATH=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password

# development | production
ENVIRONMENT=development
DISABLE_DOCS=false
CORS_ORIGINS=*
MAX_UPLOAD_MB=5
