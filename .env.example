GLM_API_KEY=your_glm_api_key_here
GLM_BASE_URL=https://api.z.ai/api/paas/v4
GLM_MODEL=glm-5.2
# 快路径：JD 解析 / 综合判分（目标 3–10s）
GLM_FAST_MODEL=glm-4.7-flash
# 行动报告模型（默认跟 GLM_MODEL；可改为更快模型保 60s SLA）
GLM_ACTION_MODEL=glm-5.2
# JD screenshot vision model
GLM_VISION_MODEL=glm-5v-turbo
LLM_MODE=auto
# 关闭深度思考以降延迟
LLM_DISABLE_THINKING=true
LLM_TIMEOUT_FAST=12
LLM_TIMEOUT_ACTION=45
LLM_TIMEOUT_DEFAULT=60
OFFEROS_HOST=127.0.0.1
OFFEROS_PORT=8000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password
AUTH_SECRET=replace-with-a-long-random-string

# development | production
ENVIRONMENT=development
DISABLE_DOCS=false
CORS_ORIGINS=*
MAX_UPLOAD_MB=5
JD_IMAGE_MAX_MB=30
# 可选：Jina Reader（网页转文本，提升招聘页抽取成功率）
# JINA_API_KEY=
