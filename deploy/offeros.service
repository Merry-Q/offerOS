[Unit]
Description=OfferOS FastAPI
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/offeros
Environment=PATH=/opt/offeros/.venv/bin
EnvironmentFile=/opt/offeros/.env
ExecStart=/opt/offeros/.venv/bin/python -m uvicorn server.main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
